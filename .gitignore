*.db
*.db-journal
*.sqlite

# Large archives (weights and images travel on the SanDisk)
*.tar
*.tar.gz
*.tar.xz

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS and editors
.DS_Store
.idea/
.vscode/
